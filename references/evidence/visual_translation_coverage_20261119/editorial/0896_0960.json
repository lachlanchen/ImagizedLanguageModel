  "decisions": [
    {
      "row": 42510,
      "action": "revise",
      "target": "军中没有战功的人，要戍守三年。"
    },
    {
      "row": 53207,
      "action": "exclude",
      "reason": "殷周诰辞末句疑义。"
    },
    {
      "row": 50324,
      "action": "revise",
      "target": "当年鄢地一战，他亲自射中楚王，击败楚军，使晋国得以安定。如今竟无人继承他的祭祀，不能不优待他的子孙。"
    },
    {
      "row": 34764,
      "action": "revise",
      "target": "再向北行一千里，便到了钵室韦。他们依胡布山而居，人口比北室韦多，不知分为几个部落。"
    },
    {
      "row": 48134,
      "action": "revise",
      "target": "另一种说法是叫作大遗之野。"
    },
    {
      "row": 22938,
      "action": "revise",
      "target": "甘愿做天下的溪谷，恒常的德行就充足了，人也就回到自然质朴的状态。"
    },
    {
      "row": 15989,
      "action": "revise",
      "target": "回答说：“最重大的是天地，其次是君臣，以此给人明确的教诲。”"
    },
    {
      "row": 21007,
      "action": "revise",
      "target": "古冶子说：“两位都为此而死，我却独自活着，这是不仁。用话羞辱别人，又夸耀自己的声名，这是不义。悔恨自己的行为却不肯死，这是没有勇气。”"
    },
    {
      "row": 26294,
      "action": "revise",
      "target": "郑袖连忙劝楚王释放张仪。"
    },
    {
      "row": 14784,
      "action": "exclude",
      "reason": "请求之事与有的宾语不明。"
    },
    {
      "row": 9909,
      "action": "exclude",
      "reason": "古医书施针条文。"
    },
    {
      "row": 19629,
      "action": "exclude",
      "reason": "秦律交接核验条文，需参考专门校注。"
    },
    {
      "row": 26507,
      "action": "retain",
      "target": "这是一句谦虚以求取意见的话。"
    },
    {
      "row": 33863,
      "action": "retain",
      "target": "百姓归向仁德，就如同水往低处流、野兽奔向旷野一样。"
    },
    {
      "row": 16859,
      "action": "exclude",
      "reason": "成辟等古义有歧解。"
    },
    {
      "row": 31789,
      "action": "revise",
      "target": "号令不足以指挥下属，刑罚不足以震慑众人，俸禄和赏赐不足以勉励百姓。如此一来，百姓便不肯主动出力。"
    },
    {
      "row": 32217,
      "action": "revise",
      "target": "燕军把坟墓全都掘开，焚烧死者的遗体。"
    },
    {
      "row": 44654,
      "action": "retain",
      "target": "岐伯说：五官是五脏的外在表现。"
    },
    {
      "row": 52544,
      "action": "revise",
      "target": "范匄从公族那里快步经过，说：“灶都推平了，井都填上了，不是撤退又是什么呢？”"
    },
    {
      "row": 52679,
      "action": "revise",
      "target": "南方风俗崇尚鬼神。狄武襄征讨侬智高时，大军刚开出桂林以南，他便祷告说：“胜负尚无凭据。”"
    },
    {
      "row": 38108,
      "action": "revise",
      "target": "十二月，国君出兵包围成邑。"
    },
    {
      "row": 54992,
      "action": "retain",
      "target": "《兑》卦象征羊，《易》中称羊的卦共有三卦。"
    },
    {
      "row": 34390,
      "action": "revise",
      "target": "王说：“张仪认为你要去楚国，我自己也知道你要去楚国。你若不往楚国，又要到哪里去呢？”"
    },
    {
      "row": 33760,
      "action": "revise",
      "target": "臣请求赐药让我死去，再开恩按国相的礼仪安葬我。这样大王既没有放过我的罪，也不会留下处置过分的名声。王说：“有道理。”"
    },
    {
      "row": 35742,
      "action": "retain",
      "target": "他的说法最为恰当。"
    },
    {
      "row": 31755,
      "action": "retain",
      "target": "十三年春天，齐国的军队攻打莒国，因为莒国依仗晋国而不事奉齐国的缘故。"
    },
    {
      "row": 7426,
      "action": "revise",
      "target": "这是人事的道理。顺势就能生存，合乎道理就能成功，逆势就会灭亡，失了道理就没有好名声。"
    },
    {
      "row": 52400,
      "action": "revise",
      "target": "魏国是个拥有万辆兵车的大国，却称自己是东方的藩属，接受冠带，春秋两季举行祭祀，因为它认为强大的秦国值得结交。"
    },
    {
      "row": 34706,
      "action": "retain",
      "target": "冬天，攻打卫国，迎接惠公回国。"
    },
    {
      "row": 43510,
      "action": "retain",
      "target": "因此，贤明的君主必定恭敬节俭，礼贤下士，从百姓那里取得财物要有制度。"
    },
    {
      "row": 32293,
      "action": "retain",
      "target": "文子说：同样的言语却让人相信，是因为诚信存在于言语之前；同样的命令却能被执行，是因为真诚存在于命令之外。"
    },
    {
      "row": 51167,
      "action": "retain",
      "target": "留在体内不离开，停留在肠胃之外，募原之间，滞留在血脉之中，停留不走，逐渐形成积聚。"
    },
    {
      "row": 26276,
      "action": "revise",
      "target": "静止和行动若合乎时机，天地都会给予帮助。静止和行动若错过时机，天地就会把所得夺去。"
    },
