    },
    {
      "row": 44421,
      "action": "exclude",
      "reason": "编队进攻指令。"
    },
    {
      "row": 52718,
      "action": "revise",
      "target": "如果不担心德行没有建立，只担心财物不够，恐怕连吊唁都来不及，哪里还有什么可祝贺的？"
    },
    {
      "row": 43362,
      "action": "retain",
      "target": "所以聪明的人不使用自己的短处，而使用愚人所擅长的；不使用自己的笨拙，而使用愚人所擅长的技艺，因此不会陷入困境。"
    },
    {
      "row": 33303,
      "action": "retain",
      "target": "只有君子才能通晓天下人的意愿。"
    },
    {
      "row": 48261,
      "action": "exclude",
      "reason": "安之所指未明。"
    },
    {
      "row": 35096,
      "action": "exclude",
      "reason": "职官与巡戒命所指需上下文。"
    },
    {
      "row": 4390,
      "action": "retain",
      "target": "所以一定要让他们养好六畜，开垦他们的田地，安定他们的居所，成年男子耕种田地有固定的亩数，妇女纺织有规定的尺度。"
    },
    {
      "row": 29936,
      "action": "exclude",
      "reason": "得法在片段中的含义有歧义。"
    },
    {
      "row": 15703,
      "action": "revise",
      "target": "记下这件事发生的时节，是合乎礼的。夏天，周朝的宰渠伯纠前来聘问。"
    },
    {
      "row": 21987,
      "action": "retain",
      "target": "因此，圣人用以沟通天下人的志向，用以确定天下的事业，用以断决天下人的疑虑。"
    },
    {
      "row": 27774,
      "action": "revise",
      "target": "曾子、子思、孟子传下圣人修心的学问。假如没有《中庸》和《孟子》七篇，后人从哪里找到入门的途径呢？"
    },
    {
      "row": 30199,
      "action": "revise",
      "target": "办丧事要尽到礼数，举行祭祀要竭尽诚心。"
    },
    {
      "row": 46248,
      "action": "retain",
      "target": "楚王非常愤怒，出动军队袭击秦国，在兰田交战，又失败了。"
    },
    {
      "row": 24947,
      "action": "revise",
      "target": "百姓的口粮，每人四鬴是上等，每人三鬴是中等，每人二鬴是下等。"
    },
    {
      "row": 15897,
      "action": "retain",
      "target": "韩庆替西周对薛公说： 您让齐国去帮助韩、魏攻打楚国，用了九年时间攻取了宛、叶以北的地方来增强韩、魏的力量，现在又让齐国去攻打秦国来增加他们的实力。"
    },
    {
