  "decisions": [
    {
      "row": 1140,
      "action": "retain",
      "target": "想要吃就吃，想要握就握。"
    },
    {
      "row": 9820,
      "action": "revise",
      "target": "子晳回来复命，王说：“这算是懂一点天意，又怎么懂得百姓的准则？”"
    },
    {
      "row": 51319,
      "action": "retain",
      "target": "韩、魏、赵、楚的意图，担心秦国兼并天下而使他们的君主成为臣子，所以集中兵力一心抵抗秦国。"
    },
    {
      "row": 16733,
      "action": "revise",
      "target": "我读白居易文集，见到一首《咏史》，注中说作于九年十一月。诗中说：“秦国磨快刀杀李斯，齐国烧开大鼎烹杀郦食其。”"
    },
    {
      "row": 12691,
      "action": "retain",
      "target": "那么我赞赏你。"
    },
    {
      "row": 19503,
      "action": "revise",
      "target": "已经进去了，恰巧那里有一棵大树，贼人撞上树跌倒，头破而死。"
    },
    {
      "row": 32544,
      "action": "revise",
      "target": "回答说：“这对您没有好处，还会损害过去的美德，所以我说也许可以就此罢手。”"
    },
    {
      "row": 23776,
      "action": "exclude",
      "reason": "天之不假易的古义需核实。"
    },
    {
      "row": 45266,
      "action": "retain",
      "target": "周的性格宽厚仁恕，不违背人情。"
    },
    {
      "row": 1941,
      "action": "retain",
      "target": "所以百姓只看见前进而看不见后退，踏着白刃也不回头。"
    },
    {
      "row": 5694,
      "action": "revise",
      "target": "公孙丑说：“这道理高深美好，可是仿佛登天一样，似乎无法企及。”"
    },
    {
      "row": 16321,
      "action": "revise",
      "target": "有人替魏国对楚王说：“您请秦国攻打魏国，秦国必不会听您的。这样您的计谋在秦国受挫，与魏国的交情也疏远了。”"
    },
    {
      "row": 32427,
      "action": "revise",
      "target": "秦惠王说：“我愿遵从。”"
    },
    {
      "row": 47511,
      "action": "retain",
      "target": "楚国答应给魏国六座城池，与它联合攻打齐国以保存燕国。"
    },
    {
      "row": 37849,
      "action": "revise",
      "target": "所以德行高尚的人，一定能得到相称的地位、俸禄、声名，也一定能享高寿。"
    },
    {
      "row": 46637,
      "action": "exclude",
      "reason": "复杂交涉及县字含义待核。"
    },
    {
      "row": 37406,
      "action": "retain",
      "target": "孟尝君说：“怎么了？”"
    },
    {
      "row": 12014,
      "action": "revise",
      "target": "楚国和魏国同赵国讲和，必定不会来救大王。"
    },
    {
      "row": 16888,
      "action": "retain",
      "target": "祝贺别人娶妻，说“荣偕伉俪”；留下物品给妻子，说“归遗细君”。"
    },
    {
      "row": 27568,
      "action": "exclude",
      "reason": "雄骏等指代难定。"
    },
    {
      "row": 43343,
      "action": "revise",
      "target": "这话是说，由于缺少食物、瘦弱不堪，到了春季一定会死。"
    },
    {
      "row": 46530,
      "action": "retain",
      "target": "建信君勃然说道：“您是看不起掌权的人而推崇商人吗？”"
    },
    {
      "row": 44491,
      "action": "retain",
      "target": "到了少皞氏衰微的时候，九黎族扰乱了道德，百姓与神灵混杂在一起，无法分辨清楚。"
