  "decisions": [
    {
      "row": 44312,
      "action": "revise",
      "target": "人自身没有破绽，妖邪就无从自行作祟。"
    },
    {
      "row": 24806,
      "action": "retain",
      "target": "平时不接触人事，但有些事情却能预先知道。"
    },
    {
      "row": 28330,
      "action": "revise",
      "target": "马夫的说辞没有章法，乡下人却很高兴。子贡说得有道理，乡下人却听不进去。"
    },
    {
      "row": 36915,
      "action": "revise",
      "target": "姨母生前那么聪明，死后怎么就如此沉寂，不能用您的力量帮助我，让我心明眼亮，稍稍赶得上同辈呢？"
    },
    {
      "row": 9931,
      "action": "retain",
      "target": "他的弟弟永一，尤其孝顺、友爱、廉洁、谨慎。"
    },
    {
      "row": 24043,
      "action": "retain",
      "target": "淫乱的产生是因为男女没有分别，男女没有分别就会导致夫妇之间失去道义。"
    },
    {
      "row": 54217,
      "action": "retain",
      "target": "唐玄宗天宝年间，南诏反叛，剑南节度使鲜于仲通率军讨伐，损失士卒六万人。"
    },
    {
      "row": 54481,
      "action": "retain",
      "target": "因为弟弟仲让在关中，不再担任内廷职务，被任命为南钜鹿太守。他到任后以礼让引导百姓，豪族都改变了心意，整饬了行为。"
    },
    {
      "row": 33222,
      "action": "revise",
      "target": "他常在钜野泽打鱼，后来做了盗贼。"
    },
    {
      "row": 43787,
      "action": "retain",
      "target": "《风俗通》说：城门失火，祸患波及池中的鱼。"
    },
    {
      "row": 42418,
      "action": "retain",
      "target": "部下保存着他的首级，埋在昭应县百姓陈晖的地里。天成初年，他的儿子挖出来并带走了。"
    },
    {
      "row": 657,
      "action": "revise",
      "target": "勇敢的人能忍痛，见到危难不害怕，感到疼痛也不动摇。胆怯的人不能忍痛，一遇险痛便眼珠乱转、扭头张望，害怕得说不出话，惊慌失色，像死去活来一般。"
    },
    {
      "row": 26869,
      "action": "retain",
      "target": "将方城外的人迁移到许。"
    },
    {
      "row": 39384,
      "action": "exclude",
      "reason": "法律条文所指待校。"
    },
    {
      "row": 17973,
      "action": "revise",
      "target": "孔子见到穿丧服、穿礼服或双目失明的人，即使对方年轻，也一定起身。经过他们身旁时，一定加快脚步。"
    },
    {
      "row": 3445,
      "action": "retain",
      "target": "当时太平日子长久，朝廷内外都以观望为政，只有星吉独自坚持正直的作风，御史巡视地方时，必定下令告诫并派遣他去。湖东佥事三宝住，是儒者，性格廉洁正直，所到之处打击贪官污吏，毫不宽容。"
    },
    {
      "row": 5132,
      "action": "retain",
      "target": "父亲叫承休，是唐朝吴房县的县令。"
    },
    {
      "row": 11286,
      "action": "exclude",
      "reason": "遗命含义需前后文。"
    },
    {
      "row": 16032,
      "action": "retain",
      "target": "五霸是胁迫诸侯去攻打诸侯的人，所以说：五霸是三代圣王的罪人。"
    },
    {
      "row": 26078,
      "action": "retain",
      "target": "马援对吕种说：国家的各位王子都已成年，而原来的防范措施尚未建立，如果他们广泛接待宾客，就会引发大案。"
    },
    {
      "row": 3487,
      "action": "retain",
      "target": "然而终究不能坚定稳固。"
    },
    {
      "row": 50283,
      "action": "revise",
      "target": "凡事都认真办理，就会有所准备，有准备便没有忧患。"
    },
    {
      "row": 53644,
      "action": "retain",
      "target": "进入平城，汉朝的救兵也到了，匈奴的骑兵于是撤退离去，汉军也停止作战返回。"
    },
    {
      "row": 25522,
      "action": "revise",
      "target": "大司乐设中大夫两人。"
    },
    {
      "row": 32279,
      "action": "retain",
      "target": "玄佐显贵了，他的母亲还在世，是一位贤德的妇人。"
    },
    {
      "row": 18177,
      "action": "exclude",
      "reason": "生杀所指依赖上文。"
    },
    {
      "row": 13691,
      "action": "retain",
      "target": "屡次都是这样，旁人觉得奇怪，夜里查看，只见他有身体没有头，身体微冷，气息微弱。于是用被子盖住他。"
    },
    {
      "row": 55260,
      "action": "retain",
      "target": "悼子答应了，惠子于是去世了。"
    },
    {
      "row": 26449,
      "action": "revise",
      "target": "处直，字允明，天复初年受封为太原郡王。"
    },
    {
      "row": 42422,
      "action": "revise",
      "target": "张衡指摘史家班氏书中的错乱和浮滥，傅玄批评《后汉》尤其烦琐，都属于这一类。"
